# Kopieren nach .env.local und ausfüllen.
# Lokal: Werte aus `npx supabase status` (nach `npx supabase start`).
# Produktion: Supabase Dashboard → Project Settings → API.

SUPABASE_URL=http://127.0.0.1:54321
# Nur server-seitig verwenden! Nie mit NEXT_PUBLIC_ prefixen.
SUPABASE_SERVICE_ROLE_KEY=

# Schützt /api/v1/cron/* (Vercel Cron sendet "Authorization: Bearer $CRON_SECRET").
CRON_SECRET=

# Kuratierungsansicht /de/admin (HTTP Basic Auth, Benutzername egal). Leer = Ansicht deaktiviert.
ADMIN_PASSWORD=
